NODE_ENV=development
# Overrides api.port from erxes.json.
# PORT=
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Required by the platform stack (tenant-scoped Mongoose models).
# MONGO_URL=mongodb://localhost:27017/erxes
# Where the browser loads the UI remote from. Unset = plugins.erxes.io/<release>/edu-tech-brave_ui/.
UI_ENTRY_URL=http://localhost:3099/remoteEntry.js
# Address the gateway uses to reach this API. Unset = localhost (dev) or plugin-edu-tech-brave-api (prod).
# LOAD_BALANCER_ADDRESS=
# Release folder on plugins.erxes.io when it starts with "3."; otherwise "latest".
# RELEASE_VERSION=

# --- AI assistant (Gemma 4) — optional, off unless AI_PROVIDER is set ---
# Suggests category/severity, writes case briefs and checks anonymous reports
# for self-identifying details. It never decides; staff do.
# Grant the `eduTechBraveAiUse` permission to the users who may use it.
#
# Option A — Google Gemini API (report text is sent to Google). Use a PAID
# (billing-enabled) project: on the unpaid tier Google may use prompts to
# improve products and human reviewers may read them, and the terms say not
# to send personal information there.
# AI_PROVIDER=google
# AI_API_KEY=<key from https://aistudio.google.com/apikey>
# AI_MODEL=gemma-4-26b-a4b-it        # or gemma-4-31b-it
#
# Option B — self-hosted, OpenAI-compatible (text stays on your server):
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1   # Ollama; vLLM/LM Studio also work
# AI_MODEL=<the Gemma 4 tag you pulled>
# AI_API_KEY=                             # only if your server requires one
#
# AI_TIMEOUT_MS=30000
# Gemini API only. Gemma 4 thinks by default (~30 s per call); minimal
# answers in ~4 s. Values: minimal (default) | high | none. With high the
# default timeout becomes 90 s (high took ~43 s in testing).
# AI_THINKING_LEVEL=minimal
# Public intake anonymity check: sends unsent report text to the model.
# Only honoured with AI_PROVIDER=openai (self-hosted): the public page is used
# by minors, which the Gemini API terms do not allow.
# AI_PUBLIC_PRIVACY_CHECK=false
